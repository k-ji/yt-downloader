{
  "manifest_version": 3,
  "name": "YT Downloader",
  "version": "1.0",
  "description": "Download YouTube audio/video via local yt-dlp",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
